  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Subaru486desuwa/dsh-beluga.git",
    "directory": "packages/github"
  },
  "homepage": "https://github.com/Subaru486desuwa/dsh-beluga#readme",
